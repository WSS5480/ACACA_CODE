<div style="font-family:'Segoe UI',Arial,sans-serif;color:#232323;max-width:560px;margin:0 auto;padding:24px">
  <div style="font-size:20px;font-weight:800;color:#1b2a4a;margin-bottom:4px">Ácasa</div>
  <div style="height:3px;width:54px;background:#e8590c;border-radius:2px;margin-bottom:18px"></div>
  <% if @name.present? %>
    <p style="font-size:15px;margin:0 0 12px">Hola <%= @name %>,</p>
  <% end %>
  <div style="font-size:15px;line-height:1.6;white-space:pre-wrap"><%= @body %></div>
  <p style="font-size:14px;margin:20px 0 0">
    Saludos,<br>
    <b><%= @from_name.presence || 'Equipo Ácasa' %></b>
  </p>
  <hr style="border:0;border-top:1px solid #e8e2db;margin:22px 0 12px">
  <p style="font-size:12px;color:#6b7280;line-height:1.5;margin:0">
    ¿Dudas? Escríbenos por WhatsApp al <b>+52 81 1824 7975</b> o responde este correo.<br>
    <a href="https://www.acasamx.com" style="color:#e8590c;text-decoration:none">www.acasamx.com</a>
  </p>
</div>
