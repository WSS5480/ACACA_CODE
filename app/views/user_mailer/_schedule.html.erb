<%# CALENDARIO DE PAGOS con lo pagado y lo que falta (parte financiada del contrato). %>
<% total_amount = installments.sum { |i| i.amount.to_f }.round(2) %>
<% total_paid = installments.sum { |i| i.paid_amount.to_f }.round(2) %>
<% remaining = [(total_amount - total_paid).round(2), 0].max %>
<div style="font-weight:800;font-size:15px;border-top:2px solid #FF6B35;border-bottom:2px solid #FF6B35;padding:6px 0;margin:22px 0 10px;text-align:center;">CALENDARIO DE PAGOS · <%= num %></div>
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:12.5px;line-height:18px;margin-bottom:8px;">
  <tr>
    <td style="padding:2px 0;">Plan: <b><%= mail_freq_label(contract.freq) %></b></td>
    <td style="padding:2px 0;text-align:right;">Monto financiado: <b><%= mail_money(contract.financed_amount) %></b></td>
  </tr>
</table>
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:12.5px;line-height:18px;border-collapse:collapse;">
  <thead>
    <tr style="text-align:left;color:#666;font-size:11px;text-transform:uppercase;">
      <th style="padding:5px 6px;border-bottom:2px solid #FF6B35;">#</th>
      <th style="padding:5px 6px;border-bottom:2px solid #FF6B35;">Vence</th>
      <th style="padding:5px 6px;border-bottom:2px solid #FF6B35;text-align:right;">Monto</th>
      <th style="padding:5px 6px;border-bottom:2px solid #FF6B35;text-align:right;">Pagado</th>
      <th style="padding:5px 6px;border-bottom:2px solid #FF6B35;">Estatus</th>
    </tr>
  </thead>
  <tbody>
    <% installments.each do |i| %>
      <% paid = i.status == 'paid' %>
      <tr style="<%= paid ? 'color:#15803d;' : '' %>">
        <td style="padding:5px 6px;border-bottom:1px solid #e5e5e5;color:#666;"><%= i.number %></td>
        <td style="padding:5px 6px;border-bottom:1px solid #e5e5e5;"><%= mail_date(i.due_date) %></td>
        <td style="padding:5px 6px;border-bottom:1px solid #e5e5e5;text-align:right;"><%= mail_money(i.amount) %></td>
        <td style="padding:5px 6px;border-bottom:1px solid #e5e5e5;text-align:right;"><%= i.paid_amount.to_f > 0 ? mail_money(i.paid_amount) : '—' %></td>
        <td style="padding:5px 6px;border-bottom:1px solid #e5e5e5;"><%= paid ? '✓ Pagado' : mail_status_label(i.status) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr style="font-weight:800;">
      <td colspan="2" style="padding:7px 6px;border-top:2px solid #FF6B35;">Totales</td>
      <td style="padding:7px 6px;border-top:2px solid #FF6B35;text-align:right;"><%= mail_money(total_amount) %></td>
      <td style="padding:7px 6px;border-top:2px solid #FF6B35;text-align:right;"><%= mail_money(total_paid) %></td>
      <td style="padding:7px 6px;border-top:2px solid #FF6B35;"></td>
    </tr>
  </tfoot>
</table>
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top:10px;font-size:13px;line-height:20px;">
  <tr>
    <td style="padding:10px 12px;background:#f0fdf4;border-radius:8px;color:#15803d;"><b>Pagado:</b> <%= mail_money(total_paid) %></td>
    <td style="width:10px;"></td>
    <td style="padding:10px 12px;background:#fff5f0;border-radius:8px;color:#9a3c00;"><b>Por pagar:</b> <%= mail_money(remaining) %></td>
  </tr>
</table>
<% if contract.paid_off? %>
  <p style="margin:10px 0 0;font-size:13px;color:#15803d;font-weight:800;">Tu contrato está liquidado. 🎉</p>
<% elsif next_due %>
  <p style="margin:10px 0 0;font-size:13px;color:#333;">Próximo pago: <b><%= mail_money(next_amount) %></b> el <b><%= mail_date(next_due) %></b>.</p>
<% end %>
