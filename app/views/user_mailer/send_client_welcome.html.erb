<% content_for :email_title do %>
  ¡Bienvenid@ a acasa, <%= @user&.name || '' %>!
<% end %>

<p style="margin-bottom: 20px;">
  Nos alegra que formes parte de acasa. Tu cuenta ya fue creada.
</p>

<% if @whatsapp_url.present? %>
  <p style="margin-bottom: 16px;">
    <strong>Activa tu cuenta por WhatsApp:</strong> toca el botón y envíanos el mensaje que aparece.
    En cuanto lo recibamos, tu cuenta quedará verificada.
  </p>
  <p style="margin: 20px 0;">
    <a href="<%= @whatsapp_url %>" style="display: inline-block; background-color: #25D366; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px;">Verificar por WhatsApp</a>
  </p>
  <p style="margin-bottom: 20px; font-size: 13px; color: #666;">
    Si el botón no funciona, abre este enlace:<br/>
    <a href="<%= @whatsapp_url %>" style="color: #128C7E; word-break: break-all;"><%= @whatsapp_url %></a>
  </p>
<% end %>

<table cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0; width: 100%;">
  <tr>
    <td style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; text-align: center;">
      <p style="margin: 0 0 8px 0; font-size: 14px; color: #666;">Tu número de cliente</p>
      <p style="margin: 0; font-size: 28px; font-weight: bold; color: #141C50; letter-spacing: 2px;">
        <%= @user.number %>
      </p>
    </td>
  </tr>
</table>

<p style="margin-bottom: 20px;">
  Para iniciar sesión usa tu <strong>correo</strong> y la <strong>contraseña</strong> que elegiste al registrarte.
</p>

<p style="margin-bottom: 20px;">¡Gracias por confiar en nosotros!</p>
